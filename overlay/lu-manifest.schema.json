{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Logical Unit manifest",
  "type": "object",
  "required": ["repo", "units", "excluded", "unpartitioned"],
  "properties": {
    "repo":   { "type": "string", "description": "owner/name@sha" },
    "units":  { "type": "array", "items": { "$ref": "#/$defs/unit" } },
    "excluded": {
      "type": "array", "description": "Out of scope: tests, docs, CI, vendored.",
      "items": { "type": "object", "required": ["path", "reason"],
                 "properties": { "path": {"type":"string"}, "reason": {"type":"string"} } }
    },
    "unpartitioned": {
      "type": "array", "description": "In scope but could not be assigned. Each one is a finding.",
      "items": { "type": "object", "required": ["path", "reason"],
                 "properties": { "path": {"type":"string"}, "reason": {"type":"string"} } }
    },
    "violations_observed": {
      "type": "array", "description": "Places where the code reaches into another unit's internals.",
      "items": { "type": "object", "required": ["from_unit", "to_unit", "location", "note"],
                 "properties": { "from_unit":{"type":"string"}, "to_unit":{"type":"string"},
                                 "location":{"type":"string"}, "note":{"type":"string"} } }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "required": ["name", "kind", "description", "files", "entrypoints", "depends_on", "effects"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": { "enum": ["domain", "infra"] },
        "description": { "type": "string", "minLength": 40,
                         "description": "One paragraph a non-programmer can follow." },
        "role": { "type": "string", "description": "One line: what this unit is responsible for." },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "entrypoints": {
          "type": "array",
          "items": { "type": "object", "required": ["name", "kind", "location"],
            "properties": {
              "name":      { "type": "string" },
              "kind":      { "enum": ["function", "class", "method", "cli", "http", "handler", "type", "constant"] },
              "location":  { "type": "string", "description": "path:line" },
              "signature": { "type": "string" },
              "plain":     { "type": "string", "description": "What calling this does, in plain language." }
            } }
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "object", "required": ["unit", "entrypoint"],
            "properties": { "unit": {"type":"string"}, "entrypoint": {"type":"string"} } }
        },
        "effects": {
          "type": "array",
          "items": { "type": "object", "required": ["kind", "description"],
            "properties": {
              "kind": { "enum": ["network", "filesystem", "database", "subprocess", "env", "clock", "random", "hardware", "other"] },
              "description": { "type": "string" } } }
        },
        "version": { "type": "string", "description": "Computed by ent. Never written by the model." }
      }
    }
  }
}
