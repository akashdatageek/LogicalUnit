    {
      "name": "argument-validators",
      "kind": "domain",
      "description": "This unit defines the rules a command-line tool can use to check whether the user typed the right number (or kind) of extra words after a command, such as requiring exactly one argument, forbidding any arguments, or rejecting duplicates. A CLI author picks one of these ready-made rules (or combines several) and attaches it to a command; Cobra then runs that rule automatically before the command's action executes. The logic is pure decision-making with no file, network, or system access involved.",
      "files": ["args.go"],
      "entrypoints": [
