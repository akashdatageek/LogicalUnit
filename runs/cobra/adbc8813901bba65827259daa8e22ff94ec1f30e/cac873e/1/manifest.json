{
  "units": [
    {
      "name": "command-tree",
      "kind": "domain",
      "description": "This is the model of a command-line program itself: a tree of named commands (like 'git' with subcommands 'commit', 'push', etc.), each with its own flags, help text, and the action it runs. This unit builds that tree, figures out which command the user meant to run (including handling misspellings and abbreviations), parses the flags and arguments given on the command line, runs the right command's action, and prints help/usage/version text when asked or when something goes wrong. It also holds a handful of package-wide switches (whether command names can be abbreviated, whether the command list is sorted, case sensitivity), a couple of small generic helpers used everywhere (CheckErr, WriteStringAndCheck), and a tiny Windows-only add-on that shows a friendly message if someone double-clicks the program in Explorer instead of running it from a terminal. It must never itself decide what a specific flag combination or positional argument means for an individual application - those policies plug in from elsewhere.",
      "files": ["command.go", "command_win.go", "command_notwin.go", "cobra.go"],
