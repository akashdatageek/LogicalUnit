    {
      "name": "flag-groups",
      "kind": "domain",
      "description": "This unit implements a rule about how command-line flags relate to each other: some flags must always be given together, some require that at least one of a set be present, and some are mutually exclusive so only one of a set may be used at a time. A developer building a command-line tool marks flags as belonging to one of these groups, and this unit checks - right before the command runs, and while suggesting flags for autocomplete - whether the user's input obeys those grouping rules, producing a clear error if not.",
      "files": ["flag_groups.go"],
      "entrypoints": [
        {"kind": "method", "name": "MarkFlagsRequiredTogether", "location": "flag_groups.go:33"},
        {"kind": "method", "name": "MarkFlagsOneRequired", "location": "flag_groups.go:49"},
